{
  "name": "melonade-option-a",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Option A - Graphite. Compact monochrome Issues page on Ant Design v6.",
  "scripts": {
    "dev": "vite --port 4310",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && vercel deploy --prod --yes",
    "preview": "vite preview --port 4311",
    "tsc": "tsc --noEmit",
    "storybook": "storybook dev -p 6310 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.3.6",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.10",
    "@storybook/addon-docs": "^9.1.10",
    "@storybook/react-vite": "^9.1.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "storybook": "^9.1.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
