    "storybook": "storybook dev -p 6320 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "@mantine/spotlight": "^8.3.0",
